@media (max-width:480px){.vpc-reloj .vpc-reloj__fila{flex-wrap:wrap}.vpc-reloj .vpc-reloj__txt{flex:1 1 auto;min-width:0}.vpc-reloj .vpc-reloj__nums{flex:0 0 100%;justify-content:center;margin:10px 0 18px!important}.vpc-reloj .vpc-reloj__nums{padding:6px 10px 6px 32px}.vpc-reloj .vpc-reloj__nums::before{left:11px;width:15px;height:15px}.vpc-reloj .vpc-reloj__nums>span{padding:0 6px}.vpc-reloj .vpc-reloj__nums b{font-size:19px;min-width:24px}.vpc-reloj .vpc-reloj__nums>span:not(:last-child)::after{font-size:16px;right:-2px}}
</style>
<script>
(function(){
  var SIG = {1:'Mañana baja a 20%',2:'Mañana baja a 15%',3:'Mañana baja a 10%',4:'Mañana vuelven los precios normales'};
  function ar(){ var d = new Date(Date.now() - 3*3600e3); return d; }
  function poner(){
    document.querySelectorAll('[data-vpc-reloj]').forEach(function(r){
      var b = r.querySelector('.vpc-barra');
      if (!b){
        b = document.createElement('div'); b.className = 'vpc-barra';
        b.innerHTML = '<div class="vpc-barra__track"><span class="vpc-barra__fill"></span></div><div class="vpc-barra__pie"><span class="vpc-barra__pas"></span><b class="vpc-barra__sig"></b></div>';
        var ah = r.querySelector('.vpc-reloj__ahorro'); r.insertBefore(b, ah || null);
      }
      var d = ar(), seg = d.getUTCHours()*3600 + d.getUTCMinutes()*60 + d.getUTCSeconds(), pct = Math.min(100, seg/864);
      b.querySelector('.vpc-barra__fill').style.width = pct.toFixed(1) + '%';
      b.querySelector('.vpc-barra__pas').textContent = 'Ya pasó el ' + Math.floor(pct) + '% del día';
      var dow = d.getUTCDay(); b.querySelector('.vpc-barra__sig').textContent = SIG[dow] || '';
    });
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', poner); else poner();
  setInterval(poner, 30000);
  document.addEventListener('shopify:section:load', poner);
})();
</script>

