{%- liquid
  assign s = section.settings
  assign producto = product
  if s.producto != blank
    assign producto = s.producto
  endif
  assign primer_pack = 0
  assign elegido = 0
  for block in section.blocks
    if block.type == 'pack'
      if primer_pack == 0
        assign primer_pack = forloop.index
      endif
      if block.settings.por_defecto and elegido == 0
        assign elegido = forloop.index
      endif
    endif
  endfor
  if elegido == 0
    assign elegido = primer_pack
  endif
  assign hay_arriba = false
  assign hay_abajo = false
  assign hay_confianza = false
  assign hay_datos = false
  assign cantidad_resenas = 0
  assign contador_checks = 0
  assign contador_packs = 0
  if s.cyber_logo != blank
    assign vpc_logo = s.cyber_logo | image_url: width: 400
  else
    assign vpc_logo = s.cyber_logo_url
  endif
  for block in section.blocks
    if block.type == 'acordeon' and block.settings.ubicacion == 'arriba'
      assign hay_arriba = true
    endif
    if block.type == 'acordeon' and block.settings.ubicacion == 'abajo'
      assign hay_abajo = true
    endif
    if block.type == 'confianza'
      assign hay_confianza = true
    endif
    if block.type == 'dato_rapido'
      assign hay_datos = true
    endif
    if block.type == 'resena'
      assign cantidad_resenas = cantidad_resenas | plus: 1
    endif
  endfor
  assign total_medios = producto.media.size
  if s.video != blank
    assign total_medios = total_medios | plus: 1
  endif
  assign rating_valor = s.rating_numero
  assign rating_cantidad = s.rating_cantidad
  if s.fuente_rating == 'app' and producto.metafields.reviews.rating.value != blank
    assign rating_valor = producto.metafields.reviews.rating.value.rating | round: 1 | append: '/5'
    assign rating_cantidad = producto.metafields.reviews.rating_count.value
  endif
-%}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Arimo:wght@400;500;700&family=Poppins:wght@400;500;600;700&display=swap">

<velora-producto
  class="{% if s.cyber_activo %}velora-producto--cyber velora-producto--vpc {% endif %}velora-producto velora-producto--titulos-{{ s.tipografia_titulos }}{% if s.checks_con_lineas %} velora-producto--checks-lineas{% endif %}{% if s.animaciones %} velora-producto--animado{% endif %}{% if s.ocultar_mobile %} velora-producto--oculto-mobile{% endif %}{% if s.ocultar_desktop %} velora-producto--oculto-desktop{% endif %}"
  style="--vpc-1:{{ s.cyber_color_1 }};--vpc-2:{{ s.cyber_color_2 }};--vpc-3:{{ s.cyber_color_3 }};--vp-fondo:{{ s.color_fondo }};--vp-tinta:{{ s.color_tinta }};--vp-azul:{{ s.color_azul }};--vp-celeste:{{ s.color_celeste }};--vp-niebla:{{ s.color_niebla }};--vp-piedra:{{ s.color_piedra }};--vp-linea:{{ s.color_linea }};--vp-estrellas:{{ s.color_estrellas }};--vp-boton-fondo:{{ s.color_boton_fondo }};--vp-boton-texto:{{ s.color_boton_texto }};--vp-boton-radio:{{ s.radio_boton }}px;--vp-pack-fondo:{{ s.color_pack_fondo }};--vp-pack-activo-fondo:{{ s.color_pack_activo_fondo }};--vp-pack-activo-borde:{{ s.color_pack_activo_borde }};--vp-pack-radio:{{ s.radio_pack }}px;--vp-chip-fondo:{{ s.color_chip_fondo }};--vp-chip-texto:{{ s.color_chip_texto }};--vp-unidad:{{ s.color_precio_unidad }};--vp-regalo-on:{{ s.color_regalo_activo }};--vp-regalo-off:{{ s.color_regalo_inactivo }};--vp-insignia-fondo:{{ s.color_insignia_fondo }};--vp-insignia-texto:{{ s.color_insignia_texto }};--vp-tachado:{{ s.color_tachado }};--vp-cuotas:{{ s.color_cuotas }};--vp-img:{{ s.tamano_imagen_pack }}px;--vp-titulo-m:{{ s.tamano_titulo_mobile }}px;--vp-titulo-d:{{ s.tamano_titulo_desktop }}px;--vp-max:{{ s.ancho_maximo }}px;--vp-pt-m:{{ s.padding_superior_mobile }}px;--vp-pb-m:{{ s.padding_inferior_mobile }}px;--vp-pt-d:{{ s.padding_superior_desktop }}px;--vp-pb-d:{{ s.padding_inferior_desktop }}px;--vp-relacion:{{ s.relacion_imagen }};--vp-ajuste:{{ s.ajuste_imagen }};"
  data-modo="{{ s.modo_boton }}"
  data-boton="{{ s.texto_boton | escape }}"
  data-agotado="{{ s.texto_agotado | escape }}"
  {%- if s.cyber_activo %}
  {%- capture vpc_clave -%}{"i":{{ s.cyber_fecha_inicio | strip | json }},"p":[{{ s.cyber_p1 }},{{ s.cyber_p2 }},{{ s.cyber_p3 }},{{ s.cyber_p4 }}],"e":[{{ s.cyber_e1 | json }},{{ s.cyber_e2 | json }},{{ s.cyber_e3 | json }},{{ s.cyber_e4 | json }}]}{%- endcapture %}
  data-cyber-k="{{ vpc_clave | base64_encode }}"
  data-cyber-pre="{{ s.pre_activo }}"
  data-cyber-pre-pct="{{ s.pre_porcentaje }}"
  data-cyber-sin-decimales="{{ s.sin_decimales }}"
  data-cyber-txt-unidad="{{ s.texto_precio_unidad | escape }}"
  data-vpc-benef-pre="{{ s.cyber_benef_pre | escape }}"
  data-vpc-benef-pre-bajada="{{ s.cyber_benef_pre_bajada | escape }}"
  data-vpc-benef-vivo="{{ s.cyber_benef_vivo | escape }}"
  data-vpc-benef-manana="{{ s.cyber_benef_manana | escape }}"
  data-vpc-benef-ultimo="{{ s.cyber_benef_ultimo | escape }}"
  data-vpc-pill-pre="{{ s.cyber_pill_pre | escape }}"
  data-vpc-pill-vivo="{{ s.cyber_pill_vivo | escape }}"
  data-vpc-reloj-pre="{{ s.cyber_reloj_pre | escape }}"
  data-vpc-reloj-pre-pie="{{ s.cyber_reloj_pre_pie | escape }}"
  data-vpc-reloj-vivo="{{ s.cyber_reloj_vivo | escape }}"
  data-vpc-ahorro-txt="{{ s.cyber_ahorro_texto | escape }}"
  data-vpc-vivo-txt="{{ s.cyber_vivo_texto | escape }}"
  {%- endif %}
  data-error-generico="{{ s.texto_error | escape }}"
>
  <div class="velora-producto__contenedor">
    <div class="velora-producto__grilla">

      <div class="velora-producto__galeria">
        <div class="velora-producto__pista" data-pista>
          {%- assign vpc_ins_hecha = false -%}
          {%- if s.video != blank -%}
            {%- assign vpc_ins_hecha = true -%}
            <div class="velora-producto__slide">
              {%- if s.cyber_activo and s.cyber_insignia -%}{%- if s.cyber_insignia_estilo == 'logo' and vpc_logo != blank -%}<img class="vpc-insignia-logo" data-vpc-insignia src="{{ vpc_logo }}" alt="" width="400" height="209" aria-hidden="true">{%- else -%}<span class="vpc-insignia" data-vpc-insignia aria-hidden="true"><span class="vpc-insignia__v">VELORA</span><span class="vpc-insignia__c">CYBER</span><svg viewBox="0 0 24 24"><path d="M13 2L4 14h7l-1 8 9-12h-7l1-8z" fill="currentColor"/></svg></span>{%- endif -%}{%- endif -%}
              {{ s.video | video_tag: autoplay: true, loop: true, muted: true, playsinline: true, controls: false, image_size: '1200x', class: 'velora-producto__medio' }}
            </div>
          {%- endif -%}
          {%- for media in producto.media -%}
            <div class="velora-producto__slide">
              {%- if forloop.first and vpc_ins_hecha == false -%}{%- if s.cyber_activo and s.cyber_insignia -%}{%- if s.cyber_insignia_estilo == 'logo' and vpc_logo != blank -%}<img class="vpc-insignia-logo" data-vpc-insignia src="{{ vpc_logo }}" alt="" width="400" height="209" aria-hidden="true">{%- else -%}<span class="vpc-insignia" data-vpc-insignia aria-hidden="true"><span class="vpc-insignia__v">VELORA</span><span class="vpc-insignia__c">CYBER</span><svg viewBox="0 0 24 24"><path d="M13 2L4 14h7l-1 8 9-12h-7l1-8z" fill="currentColor"/></svg></span>{%- endif -%}{%- endif -%}{%- endif -%}
              {%- case media.media_type -%}
                {%- when 'image' -%}
                  {{ media | image_url: width: 1400 | image_tag: class: 'velora-producto__medio', loading: forloop.first | ternary: 'eager', 'lazy', sizes: '(min-width: 990px) 55vw, 100vw', widths: '600, 900, 1200, 1400', alt: media.alt | default: producto.title }}
                {%- when 'video' -%}
                  {{ media | video_tag: autoplay: true, loop: true, muted: true, playsinline: true, controls: false, image_size: '1200x', class: 'velora-producto__medio' }}
                {%- when 'external_video' -%}
                  {{ media | external_video_tag: class: 'velora-producto__medio' }}
                {%- else -%}
                  {{ media.preview_image | image_url: width: 1400 | image_tag: class: 'velora-producto__medio', loading: 'lazy' }}
              {%- endcase -%}
            </div>
          {%- else -%}
            {%- if s.video == blank -%}
              <div class="velora-producto__slide">{{ 'product-1' | placeholder_svg_tag: 'velora-producto__medio velora-producto__medio--placeholder' }}</div>
            {%- endif -%}
          {%- endfor -%}
        </div>

        {%- if total_medios > 1 -%}
          <div class="velora-producto__puntos" aria-hidden="true">
            {%- for i in (1..total_medios) -%}
              <button type="button" class="velora-producto__punto{% if forloop.first %} velora-producto__punto--activo{% endif %}" data-punto tabindex="-1"></button>
            {%- endfor -%}
          </div>
          {%- if s.mostrar_miniaturas -%}
            <div class="velora-producto__miniaturas">
              {%- if s.video != blank -%}
                <button type="button" class="velora-producto__miniatura velora-producto__miniatura--activa" data-miniatura aria-label="Ver video">
                  {%- if s.video.preview_image -%}{{ s.video.preview_image | image_url: width: 200 | image_tag: loading: 'lazy' }}{%- endif -%}
                  <span class="velora-producto__miniatura-play" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z" fill="currentColor"/></svg></span>
                </button>
              {%- endif -%}
              {%- for media in producto.media -%}
                <button type="button" class="velora-producto__miniatura{% if forloop.first and s.video == blank %} velora-producto__miniatura--activa{% endif %}" data-miniatura aria-label="Ver imagen {{ forloop.index }}">
                  {{ media.preview_image | image_url: width: 200 | image_tag: loading: 'lazy' }}
                  {%- if media.media_type == 'video' or media.media_type == 'external_video' -%}
                    <span class="velora-producto__miniatura-play" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z" fill="currentColor"/></svg></span>
                  {%- endif -%}
                </button>
              {%- endfor -%}
            </div>
          {%- endif -%}
        {%- endif -%}
      </div>

      <div class="velora-producto__info">

        {%- if s.cyber_activo and s.cyber_mostrar_vivo -%}
          <p class="vpc-vivo" data-vpc-vivo hidden><span class="vpc-vivo__punto" aria-hidden="true"></span><span data-vpc-vivo-t></span></p>
        {%- endif -%}

        {%- if s.mostrar_prueba_social and s.texto_prueba_social != blank -%}
          <div class="velora-producto__prueba velora-producto__aparecer" style="--d:0;">
            {%- if s.avatar_1 != blank or s.avatar_2 != blank or s.avatar_3 != blank -%}
              <span class="velora-producto__avatares" aria-hidden="true">
                {%- if s.avatar_1 != blank -%}{{ s.avatar_1 | image_url: width: 80 | image_tag: class: 'velora-producto__avatar', loading: 'lazy', alt: '' }}{%- endif -%}
                {%- if s.avatar_2 != blank -%}{{ s.avatar_2 | image_url: width: 80 | image_tag: class: 'velora-producto__avatar', loading: 'lazy', alt: '' }}{%- endif -%}
                {%- if s.avatar_3 != blank -%}{{ s.avatar_3 | image_url: width: 80 | image_tag: class: 'velora-producto__avatar', loading: 'lazy', alt: '' }}{%- endif -%}
              </span>
            {%- endif -%}
            {%- if s.mostrar_verificado -%}
              <span class="velora-producto__verificado" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 2l2.4 1.8 3-.2.9 2.9 2.5 1.7-1 2.8 1 2.8-2.5 1.7-.9 2.9-3-.2L12 22l-2.4-1.8-3 .2-.9-2.9-2.5-1.7 1-2.8-1-2.8 2.5-1.7.9-2.9 3 .2z" fill="currentColor"/><path d="M8.5 12.2l2.3 2.3 4.7-4.7" fill="none" stroke="#FFFFFF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
            {%- endif -%}
            <span class="velora-producto__prueba-texto">{{ s.texto_prueba_social | escape }}</span>
          </div>
        {%- endif -%}

        {%- if s.mostrar_rating and rating_valor != blank -%}
          <a href="{{ s.link_resenas | default: '#resenas' }}" class="velora-producto__rating velora-producto__aparecer" style="--d:1;">
            <span class="velora-producto__estrellas" aria-hidden="true">
              {%- for i in (1..5) -%}<svg viewBox="0 0 24 24"><path d="M12 3.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8-5.2-2.7-5.2 2.7 1-5.8-4.3-4.1 5.9-.9z" fill="currentColor"/></svg>{%- endfor -%}
            </span>
            <strong>{{ rating_valor }}</strong>
            {%- if rating_cantidad != blank and s.texto_resenas != blank -%}
              <span class="velora-producto__rating-texto">{{ s.texto_resenas | replace: '[n]', rating_cantidad | escape }}</span>
            {%- endif -%}
          </a>
        {%- endif -%}

        {%- if s.etiqueta_principal != blank or s.etiqueta_secundaria != blank -%}
          <div class="velora-producto__etiquetas velora-producto__aparecer" style="--d:1;">
            {%- if s.etiqueta_principal != blank -%}<span class="velora-producto__etiqueta">{{ s.etiqueta_principal | escape }}</span>{%- endif -%}
            {%- if s.etiqueta_secundaria != blank -%}<span class="velora-producto__etiqueta-secundaria">{{ s.etiqueta_secundaria | escape }}</span>{%- endif -%}
          </div>
        {%- endif -%}

        <h1 class="velora-producto__titulo velora-producto__aparecer" style="--d:2;">{{ s.titulo | default: producto.title | escape }}</h1>
        {%- if s.subtitulo != blank -%}
          <p class="velora-producto__subtitulo velora-producto__aparecer" style="--d:3;">{{ s.subtitulo | escape }}</p>
        {%- endif -%}

        {%- if s.cyber_activo and s.cyber_mostrar_dias -%}
          <ol class="vpc-dias" data-vpc-dias aria-label="Descuentos de cada día del Cyber" hidden>
            {%- for i in (0..3) -%}
              <li class="vpc-dia" data-vpc-dia="{{ i }}"><small data-vpc-dia-e></small><b data-vpc-dia-p></b></li>
            {%- endfor -%}
          </ol>
        {%- endif -%}

        <ul class="velora-producto__checks">
          {%- for block in section.blocks -%}
            {%- if block.type == 'check' and block.settings.texto != blank -%}
              {%- liquid
                assign contador_checks = contador_checks | plus: 1
                assign icono_check = block.settings.icono | default: 'auto'
                if icono_check == 'auto'
                  assign txt = block.settings.texto | downcase
                  if txt contains 'mancha' or txt contains 'moho'
                    assign icono_check = 'mancha'
                  elsif txt contains 'fregar' or txt contains 'frotar' or txt contains 'esper'
                    assign icono_check = 'reloj'
                  elsif txt contains 'junta' or txt contains 'azulejo' or txt contains 'pared' or txt contains 'techo'
                    assign icono_check = 'azulejo'
                  elsif txt contains 'chorre' or txt contains 'gel'
                    assign icono_check = 'gota'
                  elsif txt contains 'limpi' or txt contains 'brill' or txt contains 'blanco' or txt contains 'aspecto'
                    assign icono_check = 'brillo'
                  else
                    assign icono_check = 'check'
                  endif
                endif
              -%}
              <li class="velora-producto__check velora-producto__aparecer" style="--d:{{ contador_checks | plus: 3 }};" {{ block.shopify_attributes }}>
                <span class="velora-producto__check-icono velora-producto__check-icono--{{ icono_check }}" aria-hidden="true">
                  {%- case icono_check -%}
                    {%- when 'mancha' -%}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle class="velora-producto__bi-mancha" style="--m:0;" cx="8.5" cy="9.5" r="3" fill="currentColor" stroke="none"/><circle class="velora-producto__bi-mancha" style="--m:1;" cx="15.5" cy="8.5" r="2" fill="currentColor" stroke="none"/><circle class="velora-producto__bi-mancha" style="--m:2;" cx="13" cy="15.5" r="2.5" fill="currentColor" stroke="none"/><path class="velora-producto__bi-chispa" opacity="0" d="M12 5.5l1.4 3.9 3.9 1.4-3.9 1.4L12 16.1l-1.4-3.9-3.9-1.4 3.9-1.4z" fill="currentColor" stroke="none"/></svg>
                    {%- when 'reloj' -%}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="13" r="7.5"/><path d="M10 3h4"/><path class="velora-producto__bi-aguja" d="M12 13V8.5"/><circle cx="12" cy="13" r="1" fill="currentColor" stroke="none"/></svg>
                    {%- when 'azulejo' -%}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="4" width="16" height="16" rx="2.5"/><path d="M12 4v16M4 12h16"/><rect class="velora-producto__bi-baldosa" x="13.5" y="5.5" width="5" height="5" rx="1" fill="currentColor" stroke="none" opacity="0"/></svg>
                    {%- when 'gota' -%}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><g class="velora-producto__bi-gota"><path d="M12 3.5c3 4 5.5 7 5.5 10a5.5 5.5 0 0 1-11 0c0-3 2.5-6 5.5-10z"/><path d="M9.6 14.2a2.4 2.4 0 0 0 2.4 2.4"/></g></svg>
                    {%- when 'brillo' -%}
                      <svg viewBox="0 0 24 24" fill="currentColor" stroke="none"><path class="velora-producto__bi-estrella" d="M10.5 4l1.6 4.9 4.9 1.6-4.9 1.6-1.6 4.9-1.6-4.9L4 10.5l4.9-1.6z"/><path class="velora-producto__bi-estrella velora-producto__bi-estrella--chica" d="M17.5 13.5l.8 2.2 2.2.8-2.2.8-.8 2.2-.8-2.2-2.2-.8 2.2-.8z"/></svg>
                    {%- when 'spray' -%}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 10h6v10a1 1 0 0 1-1 1h-4a1 1 0 0 1-1-1z"/><path d="M10 10V7h4v3"/><path d="M10 7V5h5l1 2"/><circle class="velora-producto__bi-niebla" style="--m:0;" cx="19" cy="5" r="0.9" fill="currentColor" stroke="none"/><circle class="velora-producto__bi-niebla" style="--m:1;" cx="20.5" cy="7.5" r="0.9" fill="currentColor" stroke="none"/><circle class="velora-producto__bi-niebla" style="--m:2;" cx="19" cy="10" r="0.9" fill="currentColor" stroke="none"/></svg>
                    {%- when 'escudo' -%}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l7 3v5c0 4.5-3 8-7 10-4-2-7-5.5-7-10V6z"/><path class="velora-producto__bi-trazo" pathLength="1" d="M9 12l2 2 4-4"/></svg>
                    {%- else -%}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path class="velora-producto__bi-trazo" pathLength="1" d="M6 12.5l4 4L18 8"/></svg>
                  {%- endcase -%}
                </span>
                <span>{{ block.settings.texto | escape }}</span>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>

        {%- if hay_arriba -%}
          <div class="velora-producto__acordeones">
            {%- for block in section.blocks -%}
              {%- if block.type == 'acordeon' and block.settings.ubicacion == 'arriba' -%}
                <details class="velora-producto__acordeon"{% if block.settings.abierto %} open{% endif %} {{ block.shopify_attributes }}>
                  <summary class="velora-producto__acordeon-titulo">
                    <span>{{ block.settings.titulo | escape }}</span>
                    <span class="velora-producto__acordeon-mas" aria-hidden="true"></span>
                  </summary>
                  <div class="velora-producto__acordeon-contenido">{{ block.settings.contenido }}</div>
                </details>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}

        {%- if primer_pack > 0 -%}
          {%- if s.texto_separador != blank -%}
            <div class="velora-producto__separador"><span>{{ s.texto_separador | escape }}</span></div>
          {%- endif -%}
          {%- if s.nota_packs != blank -%}
            <p class="velora-producto__nota">{{ s.nota_packs }}</p>
          {%- endif -%}

          {%- if request.design_mode -%}
            <div class="velora-producto__diagnostico">
              <strong>Solo lo ves vos en el editor · Producto que lee la sección: {{ producto.title | escape }}</strong>
              <ol>
                {%- for v in producto.variants -%}
                  <li>{{ v.title | escape }} · {{ v.price | money }}{% unless v.available %} · sin stock{% endunless %}</li>
                {%- endfor -%}
              </ol>
            </div>
          {%- endif -%}
          {%- if false -%}
            <div class="velora-producto__cuotas-banda" data-vp-cuotas>
              <span class="velora-producto__cuotas-icono" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5.5" width="18" height="13" rx="2"/><path d="M3 10h18"/><path d="M7 15h4"/></svg></span>
              <span class="velora-producto__cuotas-textos">
                {%- if s.cuotas_titulo != blank -%}<strong>{{ s.cuotas_titulo | escape }}</strong>{%- endif -%}
                {%- if s.cuotas_bajada != blank -%}<span>{{ s.cuotas_bajada | escape }}</span>{%- endif -%}
              </span>
              {%- if s.cuotas_etiqueta != blank or s.cuotas_reloj -%}
                <span class="velora-producto__cuotas-fin">
                  {%- if s.cuotas_etiqueta != blank -%}<em>{{ s.cuotas_etiqueta | escape }}</em>{%- endif -%}
                  {%- if s.cuotas_reloj -%}<i data-vp-cuotas-reloj></i>{%- endif -%}
                </span>
              {%- endif -%}
            </div>
          {%- endif -%}
          {%- if s.cyber_activo -%}
            <div class="vpc-benef" data-vpc-benef{% unless s.pre_activo %} hidden{% endunless %}>
              {%- if vpc_logo != blank -%}<img class="vpc-logo" src="{{ vpc_logo }}" alt="Velora Cyber" width="400" height="209" loading="lazy">{%- else -%}<span class="vpc-mini" aria-hidden="true"><span class="vpc-mini__brillo"></span><span class="vpc-mini__v">VELORA</span><span class="vpc-mini__c">CYBER<svg viewBox="0 0 24 24"><path d="M13 2L4 14h7l-1 8 9-12h-7l1-8z" fill="currentColor"/></svg></span><span class="vpc-mini__l">OFF</span></span>{%- endif -%}
              <span class="vpc-benef__txt"><small>{{ s.cyber_benef_titulo | escape }}</small><strong data-vpc-benef-t>{{ s.cyber_benef_pre | replace: '[pre]', s.pre_porcentaje | escape }}</strong><em data-vpc-benef-b>{{ s.cyber_benef_pre_bajada | escape }}</em></span>
            </div>
          {%- endif -%}
          <div class="velora-producto__packs" role="radiogroup" aria-label="{{ s.texto_separador | escape }}">
            {%- for block in section.blocks -%}
              {%- if block.type == 'pack' -%}
                {%- liquid
                  assign b = block.settings
                  assign contador_packs = contador_packs | plus: 1
                  assign variante = nil
                  assign vinculo = ''
                  if b.producto_oferta != blank
                    assign variante = b.producto_oferta.selected_or_first_available_variant
                    assign vinculo = 'producto'
                  endif
                  assign buscada = b.nombre_variante | strip | downcase | replace: 'Á', 'a' | replace: 'É', 'e' | replace: 'Í', 'i' | replace: 'Ó', 'o' | replace: 'Ú', 'u' | replace: 'Ñ', 'n' | replace: 'á', 'a' | replace: 'é', 'e' | replace: 'í', 'i' | replace: 'ó', 'o' | replace: 'ú', 'u' | replace: 'ñ', 'n' | replace: ' ', ''
                  if variante == blank and buscada != blank
                    assign segmento = '|' | append: buscada | append: '|'
                    for v in producto.variants
                      assign candidato = '|' | append: v.title | append: '|' | append: v.option1 | append: '|' | append: v.option2 | append: '|' | append: v.option3 | append: '|' | append: v.sku | append: '|'
                      assign candidato = candidato | downcase | replace: 'Á', 'a' | replace: 'É', 'e' | replace: 'Í', 'i' | replace: 'Ó', 'o' | replace: 'Ú', 'u' | replace: 'Ñ', 'n' | replace: 'á', 'a' | replace: 'é', 'e' | replace: 'í', 'i' | replace: 'ó', 'o' | replace: 'ú', 'u' | replace: 'ñ', 'n' | replace: ' ', ''
                      if candidato contains segmento
                        assign variante = v
                        assign vinculo = 'nombre'
                        break
                      endif
                    endfor
                    if variante == blank
                      for v in producto.variants
                        assign candidato = v.title | downcase | replace: 'Á', 'a' | replace: 'É', 'e' | replace: 'Í', 'i' | replace: 'Ó', 'o' | replace: 'Ú', 'u' | replace: 'Ñ', 'n' | replace: 'á', 'a' | replace: 'é', 'e' | replace: 'í', 'i' | replace: 'ó', 'o' | replace: 'ú', 'u' | replace: 'ñ', 'n' | replace: ' ', ''
                        if candidato contains buscada or buscada contains candidato
                          assign variante = v
                          assign vinculo = 'nombre'
                          break
                        endif
                      endfor
                    endif
                  endif
                  if variante == blank and buscada == blank
                    assign posicion = b.variante
                    if posicion == 0
                      assign posicion = contador_packs
                    endif
                    assign v_idx = posicion | minus: 1
                    assign variante = producto.variants[v_idx]
                    if variante != blank
                      assign vinculo = 'posicion'
                    endif
                  endif
                  if variante == blank
                    assign variante = producto.selected_or_first_available_variant
                  endif
                  assign total = variante.price | times: b.cantidad
                  assign comparado = variante.compare_at_price | times: b.cantidad
                  if b.precio_tachado != blank and b.precio_tachado > 0
                    assign comparado = b.precio_tachado | times: 100 | round
                  endif
                  assign por_unidad = total | divided_by: b.unidades
                  if b.precio_unidad != blank and b.precio_unidad > 0
                    assign por_unidad = b.precio_unidad | times: 100 | round
                  endif
                  assign ahorro = 0
                  if comparado > total
                    assign ahorro = comparado | minus: total
                  endif
                  if b.ahorro_manual != blank and b.ahorro_manual > 0
                    assign ahorro = b.ahorro_manual | times: 100 | round
                  endif
                  if s.sin_decimales
                    assign precio_txt = total | money_without_trailing_zeros
                    assign comparado_txt = comparado | money_without_trailing_zeros
                    assign unidad_txt = por_unidad | money_without_trailing_zeros
                    assign ahorro_txt = ahorro | money_without_trailing_zeros
                  else
                    assign precio_txt = total | money
                    assign comparado_txt = comparado | money
                    assign unidad_txt = por_unidad | money
                    assign ahorro_txt = ahorro | money
                  endif
                  if ahorro <= 0
                    assign ahorro_txt = ''
                  endif
                  assign regalo_id = ''
                  if b.regalo_producto != blank
                    assign regalo_variante = b.regalo_producto.selected_or_first_available_variant
                    if regalo_variante != blank and regalo_variante.available
                      assign regalo_id = regalo_variante.id
                    endif
                  endif
                  assign cuotas_n = b.cuotas | default: 0
                  assign cuota_txt = ''
                  if false and cuotas_n > 1
                    assign cuota_monto = total | divided_by: cuotas_n
                    if s.sin_decimales
                      assign cuota_txt = cuota_monto | money_without_trailing_zeros
                    else
                      assign cuota_txt = cuota_monto | money
                    endif
                  endif
                  assign es_elegido = false
                  if forloop.index == elegido
                    assign es_elegido = true
                    assign sel_id = variante.id
                    assign sel_cant = b.cantidad
                    assign sel_precio = precio_txt
                    assign sel_disponible = variante.available
                    assign sel_ahorro = ahorro_txt
                    assign sel_cuotas = cuotas_n
                    assign sel_cuota_txt = cuota_txt
                  endif
                  assign repeticiones = 1
                  if b.repetir_imagen
                    assign repeticiones = b.unidades
                  endif
                  assign lineas_incluye = b.incluye | newline_to_br | split: '<br />'
                -%}
                {%- liquid
                  assign vp_insignia_ok = true
                  assign vp_ins_txt = b.insignia
                  assign vp_ins_up = b.insignia | upcase
                  if vp_ins_up contains 'CUOTA'
                    assign vp_ins_txt = ''
                  endif
                  if s.cyber_activo
                    if contador_packs == 3 and s.cyber_ins_pack3 != blank
                      assign vp_ins_txt = s.cyber_ins_pack3
                    elsif contador_packs == 4 and s.cyber_ins_pack4 != blank
                      assign vp_ins_txt = s.cyber_ins_pack4
                    endif
                  endif
                  if vp_ins_txt == blank
                    assign vp_insignia_ok = false
                  endif
                -%}
                <label class="velora-producto__pack{% if es_elegido %} velora-producto__pack--activo{% endif %}{% if vp_insignia_ok %} velora-producto__pack--insignia{% endif %}" data-pack {{ block.shopify_attributes }}>
                  {%- if vp_insignia_ok -%}
                    <span class="velora-producto__pack-insignia">{{ vp_ins_txt | escape }}</span>
                  {%- endif -%}
                  <span class="velora-producto__pack-cuerpo">
                    <input
                      type="radio"
                      class="velora-producto__pack-input"
                      name="velora-pack-{{ section.id }}"
                      value="{{ variante.id }}"
                      {% if es_elegido %}checked{% endif %}
                      data-pack-input
                      data-variante="{{ variante.id }}"
                      data-cantidad="{{ b.cantidad }}"
                      data-precio="{{ precio_txt }}"
                      data-ahorro="{{ ahorro_txt }}"
                      data-regalo="{{ regalo_id }}"
                      data-disponible="{{ variante.available }}"
                      data-total="{{ total }}"
                      data-comparado="{{ comparado }}"
                      data-unidades="{{ b.unidades }}"
                      data-cyber="{% if b.excluir_cyber %}0{% else %}1{% endif %}"
                      data-cuotas="{{ cuotas_n }}"
                      data-cuota="{{ cuota_txt }}"
                    >
                    {%- if s.mostrar_circulo -%}
                      <span class="velora-producto__pack-circulo" aria-hidden="true"></span>
                    {%- endif -%}
                    {%- if b.imagen != blank -%}
                      <span class="velora-producto__pack-media{% if repeticiones > 1 %} velora-producto__pack-media--pila{% endif %}" aria-hidden="true">
                        {%- for i in (1..repeticiones) -%}
                          {{ b.imagen | image_url: width: 180 | image_tag: class: 'velora-producto__pack-img', loading: 'lazy', alt: '' }}
                        {%- endfor -%}
                      </span>
                    {%- endif -%}
                    <span class="velora-producto__pack-info">
                      <span class="velora-producto__pack-titulo">
                        {{ b.titulo | escape }}
                        {%- if b.chip != blank -%}<span class="velora-producto__pack-chip">{{ b.chip | escape }}</span>{%- endif -%}
                      </span>
                      {%- if s.mostrar_precio_unidad and s.texto_precio_unidad != blank -%}
                        <span class="velora-producto__pack-unidad" data-vpc-unidad>{{ s.texto_precio_unidad | replace: '[precio]', unidad_txt }}</span>
                      {%- endif -%}
                      {%- if b.bajada != blank -%}<span class="velora-producto__pack-bajada">{{ b.bajada | escape }}</span>{%- endif -%}
                      {%- if cuota_txt != blank -%}<span class="velora-producto__pack-cuotas" data-vp-cuotas><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5.5" width="18" height="13" rx="2"/><path d="M3 10h18"/><path d="M7 15h4"/></svg><span>{{ s.cuotas_texto_pack | replace: '[n]', cuotas_n | replace: '[monto]', cuota_txt | escape }}</span></span>{%- endif -%}
                    </span>
                    <span class="velora-producto__pack-precios">
                      <span class="velora-producto__pack-precio" data-vpc-precio>{{ precio_txt }}</span>
                      {%- if s.mostrar_tachado and comparado > total -%}
                        <s class="velora-producto__pack-tachado" data-vpc-tachado>{{ comparado_txt }}</s>
                      {%- elsif s.cyber_activo -%}
                        <s class="velora-producto__pack-tachado" data-vpc-tachado hidden></s>
                      {%- endif -%}
                      {%- if s.cyber_activo -%}<span class="vpc-pill" data-vpc-pill hidden></span>{%- endif -%}
                    </span>
                  </span>
                  {%- if request.design_mode -%}
                    <span class="velora-producto__pack-vinculo{% if vinculo == blank %} velora-producto__pack-vinculo--error{% endif %}">
                      {%- if vinculo == blank -%}
                        {%- if b.nombre_variante != blank -%}No encontramos «{{ b.nombre_variante | escape }}» en «{{ producto.title | escape }}».{%- else -%}«{{ producto.title | escape }}» no tiene variante en la posición pedida.{%- endif %} Mirá la lista de variantes de arriba.
                      {%- else -%}
                        Vinculado a: {% if vinculo == 'producto' %}{{ b.producto_oferta.title | escape }}{% else %}{{ variante.title | escape }}{% endif %} · {{ variante.price | money }}{% if b.cantidad > 1 %} × {{ b.cantidad }}{% endif %}
                      {%- endif -%}
                    </span>
                  {%- endif -%}
                  {%- if b.incluye != blank -%}
                    <span class="velora-producto__pack-incluye">
                      <span class="velora-producto__pack-incluye-interno">
                        {%- if s.texto_incluye != blank -%}<span class="velora-producto__pack-incluye-titulo">{{ s.texto_incluye | escape }}</span>{%- endif -%}
                        <span class="velora-producto__pack-incluye-lista">
                          {%- for linea in lineas_incluye -%}
                            {%- assign l = linea | strip -%}
                            {%- if l != blank -%}
                              <span class="velora-producto__pack-incluye-item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 12.5l4 4L18 8"/></svg>{{ l | escape }}</span>
                            {%- endif -%}
                          {%- endfor -%}
                        </span>
                      </span>
                    </span>
                  {%- endif -%}
                  {%- if b.regalo_texto != blank -%}
                    <span class="velora-producto__pack-regalo">
                      {%- if b.regalo_imagen != blank -%}
                        {{ b.regalo_imagen | image_url: width: 120 | image_tag: class: 'velora-producto__pack-regalo-imagen', loading: 'lazy', alt: '' }}
                      {%- else -%}
                        <span class="velora-producto__pack-regalo-icono" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3.5" y="9" width="17" height="11.5" rx="1.5"/><path d="M2.5 9h19v-.5a1.5 1.5 0 0 0-1.5-1.5H4a1.5 1.5 0 0 0-1.5 1.5z"/><path d="M12 7v13.5"/><path d="M12 7c-1.5-3-5-3.5-5-1.2C7 7 9.5 7 12 7zM12 7c1.5-3 5-3.5 5-1.2C17 7 14.5 7 12 7z"/></svg></span>
                      {%- endif -%}
                      <span class="velora-producto__pack-regalo-texto">{{ b.regalo_texto | escape }}</span>
                      {%- if b.regalo_valor != blank -%}<s class="velora-producto__pack-regalo-valor">{{ b.regalo_valor | escape }}</s>{%- endif -%}
                    </span>
                  {%- endif -%}
                </label>
              {%- endif -%}
            {%- endfor -%}
          </div>

          {%- if hay_datos -%}
            <div class="velora-producto__datos">
              {%- for block in section.blocks -%}
                {%- assign vp_dato_up = block.settings.texto | upcase -%}
                {%- assign vp_dato_ok = true -%}{%- if vp_dato_up contains 'CUOTA' -%}{%- assign vp_dato_ok = false -%}{%- endif -%}
                {%- if block.type == 'dato_rapido' and block.settings.texto != blank and block.settings.icono != 'cuotas' and vp_dato_ok -%}
                  <span class="velora-producto__dato" {{ block.shopify_attributes }}>
                    {%- case block.settings.icono -%}
                      {%- when 'envio' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 6h11v10H3z"/><path d="M14 9h4l3 3v4h-7z"/><circle cx="7" cy="17.5" r="1.8"/><circle cx="17.5" cy="17.5" r="1.8"/></svg>
                      {%- when 'reloj' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
                      {%- when 'seguro' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l7 3v5c0 4.5-3 8-7 10-4-2-7-5.5-7-10V6z"/><path d="M9 12l2 2 4-4"/></svg>
                      {%- when 'cuotas' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5.5" width="18" height="13" rx="2"/><path d="M3 10h18"/><path d="M7 15h4"/></svg>
                      {%- when 'whatsapp' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 20l1.3-3.9A8 8 0 1 1 8.1 19z"/><path d="M9.5 9.5c.4 2 2 3.6 4 4l1-1.1 1.8.8"/></svg>
                    {%- endcase -%}
                    {{ block.settings.texto | escape }}
                  </span>
                {%- endif -%}
              {%- endfor -%}
            </div>
          {%- endif -%}

          {%- if s.mostrar_ahorro and s.texto_ahorro != blank -%}
            {%- assign partes_ahorro = s.texto_ahorro | split: '[monto]' -%}
            <p class="velora-producto__ahorro" style="--vp-ahorro:{{ s.color_ahorro }};" data-ahorro-caja {% if sel_ahorro == blank %}hidden{% endif %}>
              <svg class="velora-producto__ahorro-icono" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="M13 6l6 6-6 6"/></svg>
              <span>{{ partes_ahorro[0] | escape }}<strong data-ahorro-monto>{{ sel_ahorro }}</strong>{{ partes_ahorro[1] | escape }}</span>
            </p>
          {%- endif -%}

          <form method="post" action="{{ routes.cart_add_url }}" class="velora-producto__formulario" data-formulario novalidate>
            <input type="hidden" name="id" value="{{ sel_id }}" data-id>
            <input type="hidden" name="quantity" value="{{ sel_cant }}" data-cantidad>
            <button type="submit" class="velora-producto__boton{% if s.mostrar_flecha %} velora-producto__boton--flecha{% endif %}" data-boton {% unless sel_disponible %}disabled{% endunless %}>
              <span class="velora-producto__boton-contenido">
                {%- if s.mostrar_icono_carrito -%}
                  <svg class="velora-producto__boton-icono" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9.5" cy="19.5" r="1.3"/><circle cx="17.5" cy="19.5" r="1.3"/><path d="M3 4h2.2l2.3 11h11l2-8H6.4"/></svg>
                {%- endif -%}
                <span data-boton-texto>{% if sel_disponible %}{{ s.texto_boton | escape }}{% else %}{{ s.texto_agotado | escape }}{% endif %}</span>
                {%- if s.mostrar_precio_boton -%}
                  <span class="velora-producto__boton-separador" aria-hidden="true"></span>
                  <span class="velora-producto__boton-precio" data-boton-precio>{{ sel_precio }}</span>
                {%- endif -%}
              </span>
              {%- if s.mostrar_flecha -%}
                <span class="velora-producto__boton-flecha" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M13 6l6 6-6 6"/></svg></span>
              {%- endif -%}
              <span class="velora-producto__boton-cargando" aria-hidden="true"></span>
            </button>
            {%- if false -%}
              <p class="velora-producto__cuotas-linea" data-vp-cuotas data-cuotas-linea data-plantilla="{{ s.cuotas_texto_pack | escape }}"{% if sel_cuota_txt == blank %} hidden{% endif %}>
                o <strong>{{ s.cuotas_texto_pack | replace: '[n]', sel_cuotas | replace: '[monto]', sel_cuota_txt | escape }}</strong> {{ s.cuotas_sufijo | escape }}
              </p>
            {%- endif -%}
            <p class="velora-producto__error" role="alert" data-error hidden></p>
          </form>

          {%- if s.cyber_activo and s.cyber_mostrar_reloj -%}
            <div class="vpc-reloj" data-vpc-reloj{% unless s.pre_activo %} hidden{% endunless %}>
              <div class="vpc-reloj__fila">
                {%- if vpc_logo != blank -%}<img class="vpc-logo" src="{{ vpc_logo }}" alt="Velora Cyber" width="400" height="209" loading="lazy">{%- else -%}<span class="vpc-mini" aria-hidden="true"><span class="vpc-mini__brillo"></span><span class="vpc-mini__v">VELORA</span><span class="vpc-mini__c">CYBER<svg viewBox="0 0 24 24"><path d="M13 2L4 14h7l-1 8 9-12h-7l1-8z" fill="currentColor"/></svg></span><span class="vpc-mini__l">OFF</span></span>{%- endif -%}
                <p class="vpc-reloj__txt" data-vpc-reloj-t>{{ s.cyber_reloj_pre | escape }}</p>
                <div class="vpc-reloj__nums" data-vpc-nums>
                  <span><b data-vpc-n1>??</b><small data-vpc-l1>días</small></span><span><b data-vpc-n2>??</b><small data-vpc-l2>hs</small></span><span><b data-vpc-n3>??</b><small data-vpc-l3>min</small></span>
                </div>
              </div>
              <p class="vpc-reloj__ahorro" data-vpc-hoyahorro hidden><span data-vpc-ahorro-t>{{ s.cyber_ahorro_texto | escape }}</span> <strong data-vpc-ahorro-m></strong><s class="vpc-reloj__ahorro-ref" data-vpc-ahorro-ref></s></p>
              <p class="vpc-reloj__pie" data-vpc-reloj-pie>{{ s.cyber_reloj_pre_pie | escape }}</p>
            </div>
          {%- endif -%}

          {%- if s.mostrar_tanda and s.texto_tanda != blank -%}
            {%- capture tanda_fuerte -%}<strong>{{ s.tanda_porcentaje }}%</strong>{%- endcapture -%}
            <div class="velora-producto__tanda velora-producto__tanda--{{ s.alineacion_tanda }}" style="--vp-tanda:{{ s.color_tanda }};--vp-tanda-pct:{{ s.tanda_porcentaje }}%;">
              <p class="velora-producto__tanda-texto">
                <span class="velora-producto__tanda-punto" aria-hidden="true"></span>
                <span>{{ s.texto_tanda | escape | replace: '[porcentaje]', tanda_fuerte }}</span>
              </p>
              {%- if s.mostrar_barra_tanda -%}
                <span class="velora-producto__tanda-barra" aria-hidden="true"><span class="velora-producto__tanda-relleno"></span></span>
              {%- endif -%}
            </div>
          {%- endif -%}

          {%- if s.texto_garantia != blank -%}
            <div class="velora-producto__garantia">
              <span class="velora-producto__garantia-icono" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l7 3v5c0 4.5-3 8-7 10-4-2-7-5.5-7-10V6z"/><path d="M9 12l2 2 4-4"/></svg></span>
              <p>{{ s.texto_garantia }}</p>
            </div>
          {%- endif -%}

          {%- if s.mostrar_pagos -%}
            <div class="velora-producto__pagos" aria-label="Medios de pago">
              {%- if s.fuente_pagos == 'automatico' -%}
                {%- for tipo in shop.enabled_payment_types -%}
                  <span class="velora-producto__pago">{{ tipo | payment_type_svg_tag: class: 'velora-producto__pago-svg' }}</span>
                {%- endfor -%}
              {%- else -%}
                {%- assign lista_pagos = s.lista_pagos | split: ',' -%}
                {%- for tipo in lista_pagos -%}
                  {%- assign t = tipo | strip -%}
                  {%- if t != blank -%}
                    <span class="velora-producto__pago">{{ t | payment_type_svg_tag: class: 'velora-producto__pago-svg' }}</span>
                  {%- endif -%}
                {%- endfor -%}
              {%- endif -%}
              {%- if s.logo_pago_extra_1 != blank -%}
                <span class="velora-producto__pago velora-producto__pago--imagen">{{ s.logo_pago_extra_1 | image_url: height: 60 | image_tag: loading: 'lazy', alt: s.logo_pago_extra_1.alt | default: 'Medio de pago' }}</span>
              {%- endif -%}
              {%- if s.logo_pago_extra_2 != blank -%}
                <span class="velora-producto__pago velora-producto__pago--imagen">{{ s.logo_pago_extra_2 | image_url: height: 60 | image_tag: loading: 'lazy', alt: s.logo_pago_extra_2.alt | default: 'Medio de pago' }}</span>
              {%- endif -%}
            </div>
          {%- endif -%}
        {%- endif -%}

        {%- if hay_confianza -%}
          <div class="velora-producto__confianza">
            {%- for block in section.blocks -%}
              {%- assign vp_conf_up = block.settings.titulo | upcase -%}
              {%- if block.type == 'confianza' and block.settings.icono != 'cuotas' and vp_conf_up contains 'CUOTA' -%}{%- continue -%}{%- endif -%}
              {%- if block.type == 'confianza' and block.settings.icono != 'cuotas' -%}
                <div class="velora-producto__confianza-item" {{ block.shopify_attributes }}>
                  <span class="velora-producto__confianza-icono" aria-hidden="true">
                    {%- case block.settings.icono -%}
                      {%- when 'garantia' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l7 3v5c0 4.5-3 8-7 10-4-2-7-5.5-7-10V6z"/><path d="M9 12l2 2 4-4"/></svg>
                      {%- when 'seguro' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="10.5" width="14" height="10" rx="2"/><path d="M8 10.5V7.5a4 4 0 0 1 8 0v3"/></svg>
                      {%- when 'envio' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h11v10H3z"/><path d="M14 9h4l3 3v4h-7z"/><circle cx="7" cy="17.5" r="1.8"/><circle cx="17.5" cy="17.5" r="1.8"/></svg>
                      {%- when 'cuotas' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5.5" width="18" height="13" rx="2"/><path d="M3 10h18"/><path d="M7 15h4"/></svg>
                      {%- when 'whatsapp' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20l1.3-3.9A8 8 0 1 1 8.1 19z"/><path d="M9.5 9.5c.4 2 2 3.6 4 4l1-1.1 1.8.8"/></svg>
                      {%- when 'argentina' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 21V4"/><path d="M5 4h13l-2.5 3.5L18 11H5"/></svg>
                      {%- when 'reloj' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
                    {%- endcase -%}
                  </span>
                  <span class="velora-producto__confianza-textos">
                    <strong>{{ block.settings.titulo | escape }}</strong>
                    {%- if block.settings.bajada != blank -%}<span>{{ block.settings.bajada | escape }}</span>{%- endif -%}
                  </span>
                </div>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}

        {%- if hay_abajo -%}
          <div class="velora-producto__acordeones velora-producto__acordeones--abajo">
            {%- for block in section.blocks -%}
              {%- if block.type == 'acordeon' and block.settings.ubicacion == 'abajo' -%}
                <details class="velora-producto__acordeon"{% if block.settings.abierto %} open{% endif %} {{ block.shopify_attributes }}>
                  <summary class="velora-producto__acordeon-titulo">
                    <span>{{ block.settings.titulo | escape }}</span>
                    <span class="velora-producto__acordeon-mas" aria-hidden="true"></span>
                  </summary>
                  <div class="velora-producto__acordeon-contenido">{{ block.settings.contenido }}</div>
                </details>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}

        {%- if cantidad_resenas > 0 -%}
          <velora-producto-resenas class="velora-producto__resenas" data-intervalo="{{ s.resenas_intervalo }}">
            <div class="velora-producto__resenas-pista">
              {%- assign indice_resena = 0 -%}
              {%- for block in section.blocks -%}
                {%- if block.type == 'resena' -%}
                  {%- liquid
                    assign r = block.settings
                    assign inicial_resena = r.nombre | strip | slice: 0 | upcase
                  -%}
                  <figure class="velora-producto__resena{% if indice_resena == 0 %} velora-producto__resena--activa{% endif %}" data-resena="{{ indice_resena }}" {{ block.shopify_attributes }}>
                    <span class="velora-producto__resena-foto">
                      {%- if r.foto != blank -%}
                        {{ r.foto | image_url: width: 220 | image_tag: loading: 'lazy', alt: r.nombre, class: 'velora-producto__resena-img' }}
                      {%- else -%}
                        <span class="velora-producto__resena-inicial" aria-hidden="true">{{ inicial_resena }}</span>
                      {%- endif -%}
                    </span>
                    <figcaption class="velora-producto__resena-cuerpo">
                      <span class="velora-producto__resena-arriba">
                        {%- if r.etiqueta != blank -%}<span class="velora-producto__resena-chip">{{ r.etiqueta | escape }}</span>{%- endif -%}
                        {%- if r.estrellas > 0 -%}
                          <span class="velora-producto__resena-estrellas" role="img" aria-label="{{ r.estrellas }} de 5">
                            {%- for i in (1..5) -%}<svg class="{% if i <= r.estrellas %}velora-producto__resena-estrella--llena{% endif %}" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.8l2.8 5.8 6.4.9-4.6 4.5 1.1 6.3L12 17.3l-5.7 3 1.1-6.3-4.6-4.5 6.4-.9z"/></svg>{%- endfor -%}
                          </span>
                        {%- endif -%}
                      </span>
                      {%- if r.titulo != blank -%}<strong class="velora-producto__resena-titulo">{{ r.titulo | escape }}</strong>{%- endif -%}
                      {%- if r.texto != blank -%}<span class="velora-producto__resena-texto">“{{ r.texto | escape }}”</span>{%- endif -%}
                      {%- if r.nombre != blank or r.detalle != blank -%}
                        <span class="velora-producto__resena-autor">
                          {%- if r.nombre != blank -%}<b>{{ r.nombre | escape }}</b>{%- endif -%}
                          {%- if r.detalle != blank -%}<small>{{ r.detalle | escape }}</small>{%- endif -%}
                        </span>
                      {%- endif -%}
                    </figcaption>
                  </figure>
                  {%- assign indice_resena = indice_resena | plus: 1 -%}
                {%- endif -%}
              {%- endfor -%}
            </div>
            {%- if cantidad_resenas > 1 -%}
              <div class="velora-producto__resenas-puntos" role="tablist" aria-label="Reseñas">
                {%- for i in (1..cantidad_resenas) -%}
                  <button type="button" class="velora-producto__resenas-punto{% if forloop.first %} velora-producto__resenas-punto--activo{% endif %}" data-ir="{{ forloop.index0 }}" aria-label="Reseña {{ i }}"></button>
                {%- endfor -%}
              </div>
            {%- endif -%}
          </velora-producto-resenas>
        {%- endif -%}

      </div>
    </div>
  </div>
</velora-producto>

{% stylesheet %}
.velora-producto {
  display: block !important;
  background: var(--vp-fondo) !important;
  color: var(--vp-tinta) !important;
  font-family: 'Poppins', system-ui, sans-serif !important;
  padding: var(--vp-pt-m) 0 var(--vp-pb-m) !important;
}
.velora-producto *,
.velora-producto *::before,
.velora-producto *::after {
  box-sizing: border-box !important;
}
.velora-producto__contenedor {
  max-width: var(--vp-max) !important;
  margin: 0 auto !important;
  padding: 0 16px !important;
}
.velora-producto__grilla {
  display: grid !important;
  grid-template-columns: minmax(0, 1fr) !important;
  gap: 24px !important;
}
.velora-producto__galeria {
  position: relative !important;
  min-width: 0 !important;
}
.velora-producto__pista {
  display: flex !important;
  overflow-x: auto !important;
  scroll-snap-type: x mandatory !important;
  scroll-behavior: smooth !important;
  scrollbar-width: none !important;
  border-radius: 14px !important;
  background: var(--vp-niebla) !important;
}
.velora-producto__pista::-webkit-scrollbar {
  display: none !important;
}
.velora-producto__slide {
  flex: 0 0 100% !important;
  scroll-snap-align: start !important;
  aspect-ratio: var(--vp-relacion) !important;
  overflow: hidden !important;
}
.velora-producto__medio,
.velora-producto__slide img,
.velora-producto__slide video,
.velora-producto__slide iframe,
.velora-producto__slide svg {
  display: block !important;
  width: 100% !important;
  height: 100% !important;
  object-fit: var(--vp-ajuste) !important;
  border: 0 !important;
}
.velora-producto__puntos {
  display: flex !important;
  justify-content: center !important;
  gap: 6px !important;
  margin-top: 12px !important;
}
.velora-producto__punto {
  -webkit-appearance: none !important;
  appearance: none !important;
  width: 6px !important;
  height: 6px !important;
  padding: 0 !important;
  border: 0 !important;
  border-radius: 999px !important;
  background: var(--vp-linea) !important;
  cursor: pointer !important;
  transition: width 0.3s ease, background-color 0.3s ease !important;
}
.velora-producto__punto--activo {
  width: 20px !important;
  background: var(--vp-tinta) !important;
}
.velora-producto__miniaturas {
  display: none !important;
}
.velora-producto__info {
  min-width: 0 !important;
  display: flex !important;
  flex-direction: column !important;
}
.velora-producto__prueba {
  display: flex !important;
  align-items: center !important;
  gap: 8px !important;
  margin-bottom: 6px !important;
}
.velora-producto__avatares {
  display: inline-flex !important;
  align-items: center !important;
}
.velora-producto__avatar {
  width: 26px !important;
  height: 26px !important;
  border-radius: 999px !important;
  object-fit: cover !important;
  border: 2px solid var(--vp-fondo) !important;
  background: var(--vp-niebla) !important;
}
.velora-producto__avatar + .velora-producto__avatar {
  margin-left: -9px !important;
}
.velora-producto__verificado {
  display: inline-flex !important;
  width: 20px !important;
  height: 20px !important;
  color: var(--vp-azul) !important;
  flex-shrink: 0 !important;
}
.velora-producto__verificado svg {
  width: 100% !important;
  height: 100% !important;
}
.velora-producto__prueba-texto {
  font-size: 13px !important;
  font-weight: 600 !important;
  color: var(--vp-tinta) !important;
  line-height: 1.3 !important;
}
.velora-producto__rating {
  display: inline-flex !important;
  align-self: flex-start !important;
  align-items: center !important;
  gap: 6px !important;
  margin-bottom: 10px !important;
  font-size: 13px !important;
  font-weight: 500 !important;
  color: var(--vp-tinta) !important;
  text-decoration: none !important;
}
.velora-producto__rating strong {
  font-weight: 700 !important;
}
.velora-producto__estrellas {
  display: inline-flex !important;
  gap: 1px !important;
  color: var(--vp-estrellas) !important;
}
.velora-producto__estrellas svg {
  width: 14px !important;
  height: 14px !important;
}
.velora-producto__rating-texto {
  color: var(--vp-piedra) !important;
  font-weight: 400 !important;
}
.velora-producto__rating:hover .velora-producto__rating-texto {
  text-decoration: underline !important;
  text-underline-offset: 3px !important;
}
.velora-producto__etiquetas {
  display: flex !important;
  flex-wrap: wrap !important;
  align-items: center !important;
  gap: 8px 10px !important;
  margin-bottom: 10px !important;
}
.velora-producto__etiqueta {
  display: inline-flex !important;
  align-items: center !important;
  height: 24px !important;
  padding: 0 10px !important;
  border-radius: 999px !important;
  background: color-mix(in srgb, var(--vp-azul) 10%, #FFFFFF) !important;
  color: var(--vp-tinta) !important;
  font-size: 12px !important;
  font-weight: 600 !important;
}
.velora-producto__etiqueta-secundaria {
  font-size: 11px !important;
  font-weight: 500 !important;
  letter-spacing: 0.06em !important;
  text-transform: uppercase !important;
  color: var(--vp-piedra) !important;
}
.velora-producto__titulo {
  margin: 0 !important;
  font-family: 'Poppins', system-ui, sans-serif !important;
  font-weight: 700 !important;
  font-size: var(--vp-titulo-m) !important;
  line-height: 1.15 !important;
  letter-spacing: -0.01em !important;
  color: var(--vp-tinta) !important;
}
.velora-producto--titulos-arimo .velora-producto__titulo {
  font-family: 'Arimo', 'Helvetica Neue', Arial, sans-serif !important;
  font-weight: 400 !important;
}
.velora-producto__subtitulo {
  margin: 10px 0 0 !important;
  font-size: 14px !important;
  font-weight: 400 !important;
  line-height: 1.55 !important;
  color: var(--vp-piedra) !important;
}
.velora-producto__checks {
  list-style: none !important;
  margin: 16px 0 0 !important;
  padding: 0 !important;
  display: grid !important;
  gap: 10px !important;
}
.velora-producto--checks-lineas .velora-producto__checks {
  gap: 0 !important;
}
.velora-producto__check {
  display: flex !important;
  align-items: center !important;
  gap: 12px !important;
  font-family: 'Poppins', system-ui, sans-serif !important;
  font-size: 15px !important;
  font-weight: 600 !important;
  line-height: 1.35 !important;
  color: var(--vp-tinta) !important;
}
.velora-producto--checks-lineas .velora-producto__check {
  padding: 12px 0 !important;
  border-bottom: 1px solid var(--vp-linea) !important;
}
.velora-producto--checks-lineas .velora-producto__check:last-child {
  border-bottom: 0 !important;
}
.velora-producto--titulos-arimo .velora-producto__check {
  font-family: 'Arimo', 'Helvetica Neue', Arial, sans-serif !important;
  font-weight: 400 !important;
}
.velora-producto__check-icono {
  flex-shrink: 0 !important;
  display: inline-flex !important;
  align-items: center !important;
  justify-content: center !important;
  width: 32px !important;
  height: 32px !important;
  border-radius: 10px !important;
  background: linear-gradient(135deg, var(--vp-azul), var(--vp-celeste)) !important;
  color: #FFFFFF !important;
  box-shadow: 0 4px 10px color-mix(in srgb, var(--vp-azul) 30%, transparent) !important;
}
.velora-producto__check-icono svg {
  width: 20px !important;
  height: 20px !important;
  overflow: visible !important;
}
.velora-producto__bi-mancha,
.velora-producto__bi-chispa,
.velora-producto__bi-baldosa,
.velora-producto__bi-gota,
.velora-producto__bi-estrella,
.velora-producto__bi-niebla {
  transform-box: fill-box !important;
  transform-origin: center !important;
}
.velora-producto__bi-aguja {
  transform-box: view-box !important;
  transform-origin: 12px 13px !important;
}
.velora-producto__bi-trazo {
  stroke-dasharray: 1 1 !important;
}
.velora-producto--animado .velora-producto__check-icono--mancha .velora-producto__bi-mancha {
  animation: velora-producto-bi-mancha 4.2s ease-in-out calc(var(--m) * 0.12s + 0.8s) infinite both !important;
}
.velora-producto--animado .velora-producto__check-icono--mancha .velora-producto__bi-chispa {
  animation: velora-producto-bi-chispa 4.2s ease-in-out 0.8s infinite both !important;
}
.velora-producto--animado .velora-producto__check-icono--reloj .velora-producto__bi-aguja {
  animation: velora-producto-bi-aguja 3.6s cubic-bezier(0.65, 0, 0.35, 1) 1s infinite !important;
}
.velora-producto--animado .velora-producto__check-icono--azulejo .velora-producto__bi-baldosa {
  animation: velora-producto-bi-baldosa 3.8s ease-in-out 1.2s infinite both !important;
}
.velora-producto--animado .velora-producto__check-icono--gota .velora-producto__bi-gota {
  animation: velora-producto-bi-gota 2.6s ease-in-out infinite !important;
}
.velora-producto--animado .velora-producto__check-icono--brillo .velora-producto__bi-estrella {
  animation: velora-producto-bi-estrella 2.8s ease-in-out infinite !important;
}
.velora-producto--animado .velora-producto__check-icono--brillo .velora-producto__bi-estrella--chica {
  animation-delay: 1.4s !important;
}
.velora-producto--animado .velora-producto__check-icono--spray .velora-producto__bi-niebla {
  animation: velora-producto-bi-niebla 1.8s ease-out calc(var(--m) * 0.15s) infinite both !important;
}
.velora-producto--js.velora-producto--animado .velora-producto__bi-trazo {
  animation: velora-producto-bi-trazo 0.7s cubic-bezier(0.65, 0, 0.35, 1) 0.9s both !important;
}
@keyframes velora-producto-bi-mancha {
  0%, 10% { opacity: 1; transform: scale(1); }
  38%, 82% { opacity: 0; transform: scale(0.2); }
  100% { opacity: 1; transform: scale(1); }
}
@keyframes velora-producto-bi-chispa {
  0%, 34% { opacity: 0; transform: scale(0.2) rotate(-45deg); }
  48% { opacity: 1; transform: scale(1.2) rotate(10deg); }
  58%, 76% { opacity: 1; transform: scale(1) rotate(0deg); }
  88%, 100% { opacity: 0; transform: scale(0.2) rotate(45deg); }
}
@keyframes velora-producto-bi-aguja {
  0% { transform: rotate(0deg); }
  70%, 100% { transform: rotate(360deg); }
}
@keyframes velora-producto-bi-baldosa {
  0%, 20% { opacity: 0; transform: scale(0.4); }
  40%, 70% { opacity: 0.9; transform: scale(1); }
  90%, 100% { opacity: 0; transform: scale(0.4); }
}
@keyframes velora-producto-bi-gota {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-2px); }
}
@keyframes velora-producto-bi-estrella {
  0%, 100% { opacity: 1; transform: scale(1) rotate(0deg); }
  50% { opacity: 0.55; transform: scale(0.75) rotate(45deg); }
}
@keyframes velora-producto-bi-niebla {
  0% { opacity: 0; transform: translate(-3px, 0) scale(0.5); }
  30% { opacity: 1; }
  100% { opacity: 0; transform: translate(2px, 0) scale(1.2); }
}
@keyframes velora-producto-bi-trazo {
  from { stroke-dashoffset: 1; }
  to { stroke-dashoffset: 0; }
}
.velora-producto__acordeones {
  margin-top: 16px !important;
  border-top: 1px solid var(--vp-linea) !important;
}
.velora-producto__acordeones--abajo {
  margin-top: 20px !important;
}
.velora-producto__acordeon {
  border-bottom: 1px solid var(--vp-linea) !important;
}
.velora-producto__acordeon-titulo {
  display: flex !important;
  align-items: center !important;
  justify-content: space-between !important;
  gap: 16px !important;
  padding: 16px 0 !important;
  font-size: 14px !important;
  font-weight: 600 !important;
  cursor: pointer !important;
  list-style: none !important;
}
.velora-producto__acordeon-titulo::-webkit-details-marker {
  display: none !important;
}
.velora-producto__acordeon-mas {
  position: relative !important;
  flex-shrink: 0 !important;
  width: 24px !important;
  height: 24px !important;
  border-radius: 999px !important;
  border: 1.5px solid var(--vp-linea) !important;
  transition: transform 0.3s ease, border-color 0.3s ease, background-color 0.3s ease !important;
}
.velora-producto__acordeon-mas::before,
.velora-producto__acordeon-mas::after {
  content: "" !important;
  position: absolute !important;
  top: 50% !important;
  left: 50% !important;
  width: 10px !important;
  height: 1.5px !important;
  background: var(--vp-azul) !important;
  transform: translate(-50%, -50%) !important;
  transition: background-color 0.3s ease !important;
}
.velora-producto__acordeon-mas::after {
  transform: translate(-50%, -50%) rotate(90deg) !important;
}
.velora-producto__acordeon[open] .velora-producto__acordeon-mas {
  transform: rotate(45deg) !important;
  background: var(--vp-tinta) !important;
  border-color: var(--vp-tinta) !important;
}
.velora-producto__acordeon[open] .velora-producto__acordeon-mas::before,
.velora-producto__acordeon[open] .velora-producto__acordeon-mas::after {
  background: #FFFFFF !important;
}
.velora-producto__acordeon-contenido {
  padding: 0 0 16px !important;
  font-size: 13px !important;
  font-weight: 400 !important;
  line-height: 1.65 !important;
  color: var(--vp-piedra) !important;
}
.velora-producto__acordeon[open] .velora-producto__acordeon-contenido {
  animation: velora-producto-abrir 0.35s ease both;
}
.velora-producto__acordeon-contenido p {
  margin: 0 0 8px !important;
}
.velora-producto__acordeon-contenido p:last-child {
  margin-bottom: 0 !important;
}
.velora-producto__resenas {
  display: block !important;
  margin-top: 20px !important;
}
.velora-producto__resenas-pista {
  display: grid !important;
