{% javascript %}
if (!customElements.get('velora-producto')) {
  customElements.define('velora-producto', class extends HTMLElement {
    connectedCallback() {
      this.classList.add('velora-producto--js');
      this.formulario = this.querySelector('[data-formulario]');
      this.idInput = this.querySelector('[data-id]');
      this.cantidadInput = this.querySelector('[data-cantidad]');
      this.boton = this.querySelector('[data-boton]');
      this.botonTexto = this.querySelector('[data-boton-texto]');
      this.botonPrecio = this.querySelector('[data-boton-precio]');
      this.error = this.querySelector('[data-error]');
      this.ahorroCaja = this.querySelector('[data-ahorro-caja]');
      this.ahorroMonto = this.querySelector('[data-ahorro-monto]');
      this.iniciarCuotas();
      this.querySelectorAll('[data-pack-input]').forEach((i) => i.addEventListener('change', () => this.seleccionar(i)));
      const marcado = this.querySelector('[data-pack-input]:checked');
      if (marcado) this.seleccionar(marcado);
      if (this.formulario) this.formulario.addEventListener('submit', (e) => this.agregar(e));
      this.alBloque = (e) => {
        const pack = e.target && e.target.closest ? e.target.closest('[data-pack]') : null;
        if (!pack || !this.contains(pack)) return;
        const input = pack.querySelector('[data-pack-input]');
        if (input) {
          input.checked = true;
          this.seleccionar(input);
        }
      };
      document.addEventListener('shopify:block:select', this.alBloque);
      this.iniciarGaleria();
      this.iniciarAparicion();
    }
    disconnectedCallback() {
      clearInterval(this.relojCuotas);
      document.removeEventListener('shopify:block:select', this.alBloque);
      if (this.observador) this.observador.disconnect();
    }
    iniciarCuotas() {
      const fin = (this.dataset.cuotasFin || '').trim();
      if (!/^\d{4}-\d{2}-\d{2}$/.test(fin)) return;
      const p = fin.split('-').map(Number);
      /* Termina a las 23:59:59 hora Argentina (UTC-3) */
      const limite = Date.UTC(p[0], p[1] - 1, p[2] + 1, 3, 0, 0);
      const relojes = this.querySelectorAll('[data-vp-cuotas-reloj]');
      const tic = () => {
        const ms = limite - Date.now();
        if (ms <= 0) {
          this.cuotasVencidas = true;
          this.querySelectorAll('[data-vp-cuotas]').forEach((el) => { el.hidden = true; });
          clearInterval(this.relojCuotas);
          return;
        }
        const d = Math.floor(ms / 86400000);
        const h = Math.floor((ms % 86400000) / 3600000);
        const m = Math.floor((ms % 3600000) / 60000);
        const sg = Math.floor((ms % 60000) / 1000);
        const dd = (n) => String(n).padStart(2, '0');
        const texto = d > 0 ? d + 'd ' + dd(h) + 'h ' + dd(m) + 'm' : dd(h) + 'h ' + dd(m) + 'm ' + dd(sg) + 's';
        relojes.forEach((r) => { r.textContent = 'Termina en ' + texto; });
      };
      tic();
      if (!this.cuotasVencidas) this.relojCuotas = setInterval(tic, 1000);
    }
    seleccionar(input) {
      this.querySelectorAll('[data-pack]').forEach((p) => p.classList.toggle('velora-producto__pack--activo', p.contains(input)));
      if (this.idInput) this.idInput.value = input.dataset.variante;
      if (this.cantidadInput) this.cantidadInput.value = input.dataset.cantidad;
      if (this.botonPrecio) this.botonPrecio.textContent = input.dataset.precio;
      const lineaCuotas = this.querySelector('[data-cuotas-linea]');
      if (lineaCuotas && !this.cuotasVencidas) {
        const cuota = input.dataset.cuota || '';
        lineaCuotas.hidden = !cuota;
        const fuerte = lineaCuotas.querySelector('strong');
        if (fuerte && cuota) fuerte.textContent = (lineaCuotas.dataset.plantilla || '').replace('[n]', input.dataset.cuotas).replace('[monto]', cuota);
      }
      if (this.ahorroCaja) {
        const ahorro = input.dataset.ahorro || '';
        this.ahorroCaja.hidden = !ahorro;
        if (this.ahorroMonto) this.ahorroMonto.textContent = ahorro;
        this.ahorroCaja.classList.remove('velora-producto__ahorro--cambio');
        void this.ahorroCaja.offsetWidth;
        if (ahorro) this.ahorroCaja.classList.add('velora-producto__ahorro--cambio');
      }
      const disponible = input.dataset.disponible === 'true';
      if (this.boton) this.boton.disabled = !disponible;
      if (this.botonTexto) this.botonTexto.textContent = disponible ? this.dataset.boton : this.dataset.agotado;
      if (this.error) this.error.hidden = true;
    }
    mostrarError(mensaje) {
      if (!this.error) return;
      this.error.textContent = mensaje || this.dataset.errorGenerico;
      this.error.hidden = false;
    }
    agregar(e) {
      e.preventDefault();
      if (!this.boton || this.boton.disabled || this.boton.classList.contains('velora-producto__boton--cargando')) return;
      this.boton.classList.add('velora-producto__boton--cargando');
      this.boton.setAttribute('aria-busy', 'true');
      const raiz = window.Shopify && window.Shopify.routes ? window.Shopify.routes.root : '/';
      const marcado = this.querySelector('[data-pack-input]:checked');
      const regalo = marcado ? marcado.dataset.regalo || '' : '';
      const varianteId = this.idInput ? this.idInput.value : '';
      let datos = new FormData(this.formulario);
      if (regalo) {
        datos = new FormData();
        datos.append('items[0][id]', varianteId);
        datos.append('items[0][quantity]', this.cantidadInput ? this.cantidadInput.value : '1');
        datos.append('items[1][id]', regalo);
        datos.append('items[1][quantity]', '1');
        datos.append('items[1][properties][_regalo]', 'Incluido con tu pack');
      }
      const cajon = document.querySelector('cart-drawer');
      const usarCajon = this.dataset.modo === 'carrito' && cajon && typeof cajon.renderContents === 'function' && typeof cajon.getSectionsToRender === 'function';
      if (usarCajon) {
        datos.append('sections', cajon.getSectionsToRender().map((x) => x.id));
        datos.append('sections_url', window.location.pathname);
      }
      fetch(raiz + 'cart/add.js', {
        method: 'POST',
        headers: { 'X-Requested-With': 'XMLHttpRequest', Accept: 'application/javascript' },
        body: datos
      })
        .then((r) => r.json())
        .then((respuesta) => {
          if (respuesta.status) {
            this.mostrarError(respuesta.description || respuesta.message);
            return;
          }
          if (this.dataset.modo === 'checkout') {
            window.location.href = raiz + 'checkout';
            return;
          }
          if (typeof publish === 'function' && typeof PUB_SUB_EVENTS !== 'undefined') {
            publish(PUB_SUB_EVENTS.cartUpdate, { source: 'velora-producto', productVariantId: varianteId, cartData: respuesta });
          }
          if (usarCajon) {
            try {
              cajon.classList.remove('is-empty');
              cajon.renderContents(respuesta);
            } catch (err) {
              window.location.href = raiz + 'cart';
            }
            return;
          }
          window.location.href = raiz + 'cart';
        })
        .catch(() => this.mostrarError())
        .finally(() => {
          this.boton.classList.remove('velora-producto__boton--cargando');
          this.boton.removeAttribute('aria-busy');
        });
    }
    iniciarGaleria() {
      const pista = this.querySelector('[data-pista]');
      if (!pista) return;
      const miniaturas = Array.from(this.querySelectorAll('[data-miniatura]'));
      const puntos = Array.from(this.querySelectorAll('[data-punto]'));
      const marcar = (n) => {
        miniaturas.forEach((m, i) => m.classList.toggle('velora-producto__miniatura--activa', i === n));
        puntos.forEach((p, i) => p.classList.toggle('velora-producto__punto--activo', i === n));
      };
      const ir = (n) => pista.scrollTo({ left: n * pista.clientWidth });
      miniaturas.forEach((m, i) => m.addEventListener('click', () => ir(i)));
      puntos.forEach((p, i) => p.addEventListener('click', () => ir(i)));
      let espera = false;
      pista.addEventListener('scroll', () => {
        if (espera) return;
        espera = true;
        requestAnimationFrame(() => {
          marcar(Math.round(pista.scrollLeft / Math.max(pista.clientWidth, 1)));
          espera = false;
        });
      }, { passive: true });
    }
    iniciarAparicion() {
      const elementos = this.querySelectorAll('.velora-producto__aparecer');
      const reducido = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!('IntersectionObserver' in window) || reducido) {
        elementos.forEach((el) => el.classList.add('velora-producto__aparecer--visible'));
        return;
      }
      this.observador = new IntersectionObserver((entradas) => {
        entradas.forEach((entrada) => {
          if (entrada.isIntersecting) {
            entrada.target.classList.add('velora-producto__aparecer--visible');
            this.observador.unobserve(entrada.target);
          }
        });
      }, { threshold: 0.15 });
      elementos.forEach((el) => this.observador.observe(el));
    }
  });
}
if (!customElements.get('velora-producto-resenas')) {
  customElements.define('velora-producto-resenas', class extends HTMLElement {
    connectedCallback() {
      this.tarjetas = Array.from(this.querySelectorAll('[data-resena]'));
      this.puntos = Array.from(this.querySelectorAll('[data-ir]'));
      this.actual = 0;
      if (this.tarjetas.length < 2) return;
      this.reducido = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      this.alClick = (e) => {
        const punto = e.target.closest('[data-ir]');
        if (!punto) return;
        this.mostrar(parseInt(punto.dataset.ir, 10) || 0);
        this.reiniciar();
      };
      this.addEventListener('click', this.alClick);
      this.pista = this.querySelector('.velora-producto__resenas-pista');
      this.classList.add('velora-producto__resenas--deslizable');
      this.alTocar = (e) => {
        if (e.pointerType === 'mouse' && e.button !== 0) return;
        this.inicioX = e.clientX;
        this.inicioY = e.clientY;
        this.dx = 0;
        this.tocando = true;
        this.arrastrando = false;
        this.pausado = true;
        try { this.pista.setPointerCapture(e.pointerId); } catch (err) {}
      };
      this.alMover = (e) => {
        if (!this.tocando) return;
        const dx = e.clientX - this.inicioX;
        const dy = e.clientY - this.inicioY;
        if (!this.arrastrando) {
          if (Math.abs(dy) > 10 && Math.abs(dy) > Math.abs(dx)) {
            this.tocando = false;
            return;
          }
          if (Math.abs(dx) < 8) return;
          this.arrastrando = true;
          this.classList.add('velora-producto__resenas--arrastrando');
        }
        this.dx = dx;
        this.tarjetas[this.actual].style.setProperty('--vp-arrastre', dx + 'px');
      };
      this.alSoltar = () => {
        const dx = this.arrastrando ? this.dx : 0;
        const deslizo = this.arrastrando;
        this.tocando = false;
        this.arrastrando = false;
        this.classList.remove('velora-producto__resenas--arrastrando');
        this.tarjetas.forEach((t) => t.style.removeProperty('--vp-arrastre'));
        if (deslizo) {
          const total = this.tarjetas.length;
          if (dx <= -40) this.mostrar((this.actual + 1) % total);
          else if (dx >= 40) this.mostrar((this.actual - 1 + total) % total);
          this.reiniciar();
        }
        this.pausado = this.matches(':hover');
      };
      this.pista.addEventListener('pointerdown', this.alTocar);
      this.pista.addEventListener('pointermove', this.alMover);
      this.pista.addEventListener('pointerup', this.alSoltar);
      this.pista.addEventListener('pointercancel', this.alSoltar);
      this.pausar = () => { this.pausado = true; };
      this.seguir = () => { this.pausado = false; };
      this.addEventListener('mouseenter', this.pausar);
      this.addEventListener('mouseleave', this.seguir);
      this.addEventListener('focusin', this.pausar);
      this.addEventListener('focusout', this.seguir);
      this.alElegir = (e) => {
        const i = this.tarjetas.indexOf(e.target);
        if (i < 0) return;
        this.pausado = true;
        this.mostrar(i);
      };
      this.alSoltarBloque = (e) => {
        if (this.tarjetas.indexOf(e.target) >= 0) this.pausado = false;
      };
      document.addEventListener('shopify:block:select', this.alElegir);
      document.addEventListener('shopify:block:deselect', this.alSoltarBloque);
      if (this.reducido) return;
      if ('IntersectionObserver' in window) {
        this.obs = new IntersectionObserver((entradas) => {
          this.visible = entradas[0].isIntersecting;
          if (this.visible) this.reiniciar();
          else clearInterval(this.reloj);
        }, { threshold: 0.3 });
        this.obs.observe(this);
      } else {
        this.visible = true;
        this.reiniciar();
      }
    }
    disconnectedCallback() {
      clearInterval(this.reloj);
      if (this.obs) this.obs.disconnect();
      if (this.alClick) this.removeEventListener('click', this.alClick);
      document.removeEventListener('shopify:block:select', this.alElegir);
      document.removeEventListener('shopify:block:deselect', this.alSoltarBloque);
    }
    reiniciar() {
      clearInterval(this.reloj);
      if (this.reducido || !this.visible) return;
      const segundos = Math.max(parseFloat(this.dataset.intervalo) || 6, 2);
      this.reloj = setInterval(() => {
        if (!this.pausado) this.mostrar((this.actual + 1) % this.tarjetas.length);
      }, segundos * 1000);
    }
    mostrar(i) {
      this.actual = i;
      this.tarjetas.forEach((t, n) => t.classList.toggle('velora-producto__resena--activa', n === i));
      this.puntos.forEach((p, n) => {
        p.classList.toggle('velora-producto__resenas-punto--activo', n === i);
        p.setAttribute('aria-selected', n === i ? 'true' : 'false');
      });
    }
  });
}

(function () {
  /* VELORA CYBER · Pre-Cyber (% Pre + ??) y del día 1 al 4 el % de cada día. Fecha y % van cifrados. */
  var DIA = 864e5, ART = 3 * 36e5;
  function iniciar(el) {
    if (!el.dataset.cyberK || el.dataset.vpcListo) return;
    el.dataset.vpcListo = '1';
    var d = el.dataset, datos;
    try { datos = JSON.parse(decodeURIComponent(escape(window.atob(d.cyberK)))); } catch (err) { return; }
    var q = function (a) { return el.querySelector(a); }, qa = function (a) { return el.querySelectorAll(a); };
    var partes = (datos.i || '').split('-');
    var inicio = Date.UTC(+partes[0], (+partes[1] || 1) - 1, +partes[2] || 1);
